# Travel Agent Onboarding Hub example settings
#
# This file is a safe example only.
# Later, the real .env file will hold private settings and must not be uploaded to GitHub.

PROJECT_NAME="Travel Agent Onboarding Hub"
ENVIRONMENT="development"

# Backend
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"

# Frontend
FRONTEND_URL="http://localhost:5173"

# Database
# This will be filled in during the database setup phase.
DATABASE_URL="postgresql://username:password@localhost:5432/travel_agent_onboarding_hub"

# Login security
# This will be replaced with a private secret during the authentication phase.
JWT_SECRET_KEY="change-this-before-real-use"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Stripe placeholders
# Real Stripe keys should only be added when payments are ready to be connected.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

