# Travel Agent Onboarding Hub example settings
#
# This file is a safe example only.
# Later, the real .env file will hold private settings and must not be uploaded to GitHub.

PROJECT_NAME="Travel Agent Onboarding Hub"
ENVIRONMENT="development"

# Backend
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
UPLOAD_DIR="backend/uploads"
MAX_UPLOAD_SIZE_MB="100"

# Frontend
FRONTEND_URL="http://localhost:5173"

# Database
# PostgreSQL database connection.
# Replace username and password with your real local PostgreSQL details.
DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/travel_agent_onboarding_hub"

# Login security
# Replace this with a long private random value before real use.
JWT_SECRET_KEY="change-this-before-real-use"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="720"

# Stripe billing
# Use sk_test_... while testing. Only use sk_live_... when you are ready for real billing data.
# The portal reads customers, invoices, and webhooks. Creating charges/subscriptions still needs your approval.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_AGENT_SETUP_PRICE_ID=""
STRIPE_AGENT_MONTHLY_PRICE_ID=""
STRIPE_NIGHTLY_SYNC_LIMIT="500"

# Password reset emails
# Leave these blank until you connect an email provider.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES="60"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"

# Admin message tickets
# New agent messages are emailed here.
ACCOUNTS_EMAIL="accounts@onetravelclub.co.uk"

# Certificate names
CERTIFICATE_INSTRUCTOR_NAME="Nikki Bishop"
CERTIFICATE_AUTHORIZED_SIGNATORY="G Barratt"

# Render dashboard usage
# Optional: add a Render API key in Render so the admin dashboard can show hosting usage.
RENDER_API_KEY=""
RENDER_API_BASE_URL="https://api.render.com/v1"
RENDER_SERVICE_NAME_FILTER="one-travel-club-onboarding"
RENDER_SERVICE_IDS=""
RENDER_METRICS_WINDOW_MINUTES="60"

# First online admin account
# These are used only when the online database is first created.
INITIAL_ADMIN_EMAIL="admin@onetravelclub.co.uk"
INITIAL_ADMIN_PASSWORD=""
